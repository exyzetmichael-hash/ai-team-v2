# Шаблон секретов для профиля "brain" (второй мозг).
# На VPS кладётся сюда:  ~/.hermes/profiles/brain/.env
# Скопируй, впиши реальные значения. В git реальный .env НЕ коммить.

# --- Провайдер: OpenRouter (тот же ключ, что у секретаря, можно переиспользовать) ---
OPENROUTER_API_KEY=<sk-or-...>

# --- Vault ---
# Абсолютный путь к локальному клону vault-репозитория (см. docs/phase-3-runbook.md).
# Тот же путь должен быть в config.yaml → terminal.cwd и mcp_servers.filesystem.args.
OBSIDIAN_VAULT_PATH=/home/michael/vault

# Fine-grained PAT, ограниченный ТОЛЬКО vault-репозиторием:
# Contents: Read and write, Pull requests: Read and write.
# НЕ общий GitHub-токен — если утечёт, ущерб ограничен одним репо.
GITHUB_TOKEN=<github_pat_...>
