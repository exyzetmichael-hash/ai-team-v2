# Шаблон секретов для профиля "edith".
# На VPS кладётся сюда:  ~/.hermes/profiles/edith/.env
# Скопируй, впиши реальные значения. В git реальный .env НЕ коммить.

# --- Провайдер ---
OPENROUTER_API_KEY=<sk-or-...>

# --- Telegram: НОВЫЙ бот, не переиспользуй старые семь ---
# Завести через @BotFather -> /newbot -> имя "EDITH" (или как решишь).
TELEGRAM_BOT_TOKEN=<токен нового бота>
# ID своего Telegram-аккаунта — узнать у @userinfobot. Доступ только владельцу.
TELEGRAM_ALLOWED_USERS=<твой numeric id>

# --- Guest Bridge (Telegram, @упоминание из любого чата, см. docs/guest-bridge.md) ---
# Локальный OpenAI-совместимый API самой EDITH (gateway.platforms.api_server
# в config.yaml) — мост дёргает через него ту же личность/память, что и в личке.
API_SERVER_KEY=<сгенерировать: openssl rand -hex 32>
# Токен ОТДЕЛЬНОГО бота-двойника EDITH (то же имя+аватарка, другой юзернейм),
# заведённого специально под Guest Mode в BotFather. НЕ токен основного бота
# выше — Telegram не даёт два одновременных getUpdates на один токен, если
# использовать TELEGRAM_BOT_TOKEN здесь, мост конфликтует с самим гейтвеем
# EDITH и может уронить основной бот. Подробности в docs/guest-bridge.md.
GUEST_BOT_TOKEN=<токен бота-двойника из @BotFather>

# --- Todoist ---
TODOIST_API_KEY=<из https://app.todoist.com/app/settings/integrations/developer>

# OBSIDIAN_VAULT_PATH и GITHUB_TOKEN убраны 2026-08-14 — vault перенесён
# Михаилом в локальный Obsidian под Claude Code, EDITH к нему больше не
# обращается (см. git-историю этого файла, если понадобится вернуть).

# --- Google Workspace (Calendar + Sheets) ---
# OAuth настраивается диалогово через сам чат с EDITH, НЕ через .env (см. новый
# runbook). Эта строка — не для значения, а напоминание: если раньше был
# авторизован только --services calendar (у секретаря), для таблицы
# финансов нужно ПЕРЕАВТОРИЗОВАТЬ с добавленным scope sheets — старый токен
# calendar-only доступа к Sheets не даёт.
