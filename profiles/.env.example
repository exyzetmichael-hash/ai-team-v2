# Шаблон секретов для профиля секретаря.
# На VPS кладётся сюда:  ~/.hermes/profiles/secretary/.env
# Скопируй этот файл, впиши реальные значения. В git реальный .env НЕ коммить.

# --- Провайдер (CheapVibeCode, OpenAI-совместимый) ---
# Для провайдера custom Hermes читает ключ из переменной ниже.
# Если после hermes model ключ окажется под другим именем — используй то,
# что предложил мастер. Базовый вариант:
OPENAI_API_KEY=<CHEAPVIBECODE_API_KEY>
# base_url задаётся в config.yaml (model.base_url), не здесь.

# --- Telegram (второй вход + доставка напоминаний) ---
# Токен бота секретаря — получить у @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=<SECRETARY_BOT_TOKEN>
# Только твой Telegram user id (узнать у @userinfobot). Через запятую, если несколько.
TELEGRAM_ALLOWED_USERS=<YOUR_TELEGRAM_USER_ID>
