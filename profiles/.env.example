# Шаблон секретов для профиля секретаря.
# На VPS кладётся сюда:  ~/.hermes/profiles/secretary/.env
# Скопируй этот файл, впиши реальные значения. В git реальный .env НЕ коммить.

# --- Провайдер (CheapVibeCode, OpenAI-совместимый) ---
# ВАЖНО: для provider: custom ключ сюда НЕ идёт. Hermes читает api_key для
# кастомных эндпоинтов только из config.yaml (model.api_key), не из .env.
# OPENAI_API_KEY ниже подхватывается ТОЛЬКО встроенным провайдером openai-api
# (прямой OpenAI) — для CheapVibeCode он ни на что не влияет, оставлен
# закомментированным для справки, если когда-то понадобится тот провайдер.
# OPENAI_API_KEY=<OPENAI_DIRECT_KEY_IF_EVER_NEEDED>
# base_url и api_key для CheapVibeCode — оба в config.yaml, см. profiles/secretary/config.yaml.

# --- Telegram (второй вход + доставка напоминаний) ---
# Токен бота секретаря — получить у @BotFather (/newbot).
TELEGRAM_BOT_TOKEN=<SECRETARY_BOT_TOKEN>
# Только твой Telegram user id (узнать у @userinfobot). Через запятую, если несколько.
TELEGRAM_ALLOWED_USERS=<YOUR_TELEGRAM_USER_ID>
