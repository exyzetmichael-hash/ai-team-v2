[Unit]
Description=EDITH finance webhook (банковские пуши с телефона -> лист Операции)
# Как и guest-bridge, это отдельный процесс, а не часть гейтвея: упадёт —
# EDITH продолжает работать, потеряются только автоматические траты, и то
# не насовсем (MacroDroid просто получит ошибку, уведомление останется на
# телефоне).
After=network.target
# ⚠️ 2026-08-28: раньше здесь была зависимость от tailscaled, потому что
# сервис биндился на tailnet-адрес. Отказались от Tailscale-only схемы —
# Михаилу нужен обычный VPN для других приложений почти постоянно, а
# Android не даёт двум VPN работать разом, так что MacroDroid регулярно
# терял связь с вебхуком. Теперь сервис слушает 127.0.0.1, а наружу его
# выставляет Caddy (см. docs/finance-capture.md) с обычным публичным
# HTTPS — работает независимо от того, какой VPN включён на телефоне.
# Тайскейл-зависимость больше не нужна: 127.0.0.1 доступен сразу при
# старте системы.

[Service]
Type=simple
Environment="HERMES_HOME=/home/michael/.hermes/profiles/edith"
ExecStart=/home/michael/.hermes/hermes-agent/venv/bin/python3 /home/michael/.hermes/profiles/edith/scripts/finance_webhook.py
Restart=always
RestartSec=5
# Интерфейс Tailscale может подняться позже сервиса — не сдаёмся после
# нескольких неудачных стартов подряд.
StartLimitIntervalSec=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
